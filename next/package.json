{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.7.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next node_modules",
    "lint": "eslint && pnpm run check:vendor-baseline",
    "lint:fix": "eslint --fix && pnpm run check:vendor-baseline",
    "check:vendor-baseline": "node scripts/check-vendor-baseline.mjs",
    "prettier": "prettier --check 'src/**/*.{js,ts,jsx,tsx}'",
    "prettier:fix": "prettier --write 'src/**/*.{js,ts,jsx,tsx}'",
    "format": "pnpm run lint && pnpm run prettier",
    "format:fix": "pnpm run lint:fix && pnpm run prettier:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock:gen": "node mock/generate.mjs",
    "mock:serve": "node mock/server.mjs",
    "mock:start": "node --env-file=.env.mock node_modules/next/dist/bin/next start",
    "mock:measure": "node mock/measure.mjs run",
    "mock:smoke": "node mock/smoke.mjs",
    "mock:dom": "node mock/dom-snapshot.mjs",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "html-react-parser": "^6.1.9",
    "lucide-react": "^1.59.0",
    "next": "16.4.6",
    "next-intl": "^4.5.8",
    "radix-ui": "^1.8.1",
    "react": "19.2.3",
    "react-aria": "^3.53.1",
    "react-dom": "19.2.3",
    "react-markdown": "^9.0.1",
    "react-resize-detector": "^12.3.0",
    "react-stately": "^3.51.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^31.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "shadcn": "4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>deepmerge-ts": "^8.0.0"
    }
  }
}
