# mock 모드 환경 변수 템플릿. `cp .env.mock.example .env.mock` 뒤 `pnpm mock:start` 가
# `node --env-file=.env.mock` 로 읽는다(.env 의 같은 키보다 우선, 없는 키는 .env 값을 쓴다).
# 실제 API 키는 필요 없다. README "mock 모드" 참고.

# pnpm mock:serve 가 띄우는 mock upstream (MOCK_PORT 를 바꿨으면 함께 바꾼다)
UPSTAGE_CONSOLE_API_URL=http://127.0.0.1:4010
# mock 서버는 비어 있지 않은 Bearer 토큰이면 받는다
UPSTAGE_API_KEY=mock-key
# mock 페이지 이미지는 http 로 오므로 loopback http 이미지 URL 을 허용한다 (개발 전용)
UPSTAGE_ALLOW_HTTP_IMAGE_URLS=1
# 검수 상태(검수 중·완료)를 두는 앱 DB. mock 모드도 로컬 Postgres 를 쓴다(README "mock 모드")
DATABASE_URL=postgresql://myuser:mypassword@localhost:5435/mydb
# 1 이면 UI Kit 데모 화면(/{locale}/ui-kit-demo)에 접근할 수 있다. 기본은 꺼짐(404). README "UI Kit 데모 화면" 참고
# REVIEW_UI_KIT_DEMO=1
