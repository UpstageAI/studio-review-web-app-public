# 환경 변수는 next/.env 에 둔다. 레포에 커밋하지 않는다(.gitignore 의 .env*).
#   next/.env        — DATABASE_URL, UPSTAGE_CONSOLE_API_URL, UPSTAGE_API_KEY
# 루트 scripts/setup.sh 는 .env 가 없을 때만 이 파일을 .env 로 복사한다.

# Prisma CLI 는 .env 만 읽으므로 반드시 .env 에 둔다.
DATABASE_URL=postgresql://myuser:mypassword@localhost:5435/mydb

# Upstage 콘솔 API 게이트웨이. 비우면 https://api.upstage.ai 를 쓴다. 끝에 / 를 붙이지 않는다.
UPSTAGE_CONSOLE_API_URL=
# Upstage 콘솔에서 발급한 API 키. 서버에서만 읽으며 브라우저로 보내지 않는다.
UPSTAGE_API_KEY=

# 개발 전용. 1 이면 loopback(127.0.0.1·localhost·[::1]) http 페이지 이미지 URL 을 브라우저에 넘긴다
# (로컬 mock upstream 용, README "mock 모드"). 기본은 비워 두고 운영·공개망에서는 켜지 않는다.
# UPSTAGE_ALLOW_HTTP_IMAGE_URLS=

# 1 이면 UI Kit 데모 화면(/{locale}/ui-kit-demo, 고정 데이터)에 접근할 수 있다(자동으로 뜨지 않고
# 이 경로로 직접 들어간다). 서버가 요청 시점에 읽으므로 같은 빌드에서 env 만 바꿔 다시 띄우면 된다.
# 비우면 그 경로는 404 다(README "UI Kit 데모 화면").
# REVIEW_UI_KIT_DEMO=1
